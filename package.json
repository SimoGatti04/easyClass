{
  "name": "teacher-service",
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "description": "Teacher Service — Domain Core, Materials Management, and MCP Service",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "teacher-service": "bin/teacher-service.js",
    "teacher-service-mcp": "bin/teacher-service-mcp.js",
    "teacher-service-http": "bin/teacher-service-http.js"
  },
  "scripts": {
    "test": "node tests/run-all.js",
    "test:unit": "node tests/unit/run-unit.js",
    "test:integration": "node tests/integration/run-integration.js",
    "test:mcp": "node tests/mcp/run-mcp.js",
    "mcp": "node --env-file=.env.local bin/teacher-service-mcp.js",
    "start:http": "node --env-file=.env.local bin/teacher-service-http.js",
    "build:client": "vite build",
    "dev:preview": "node bin/teacher-service-preview.js",
    "dev:preview:clean": "node bin/teacher-service-preview-clean.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "3.25.76"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4",
    "playwright": "1.62.1"
  }
}
